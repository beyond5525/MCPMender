{
  "name": "mcpmender",
  "version": "0.3.0-beta.2",
  "type": "module",
  "description": "MCPMender (协议修匠): cross-platform MCP configuration diagnostics, live handshake checks, and safe repair.",
  "author": "MCPMender contributors",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "diagnostics",
    "repair",
    "codex",
    "claude",
    "cursor"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "beta"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mcpmender": "dist/mcpmender.cjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "@mcpmender/core": "workspace:*",
    "esbuild": "^0.28.1"
  }
}
